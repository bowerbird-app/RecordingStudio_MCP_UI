<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.header do %>
    <%= render FlatPack::PageTitle::Component.new(
      title: title.presence || "Page story",
      subtitle: "Story and outline.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>
  <% end %>
  <% card.body do %>
    <%= render FlatPack::Tabs::Component.new(default_tab: 0, variant: :underline) do |tabs| %>
      <% tabs.tab(label: "Story", id: "story") do %>
        <%= render FlatPack::Content::Component.new(data: { mcp_text: "summary" }) do %>
          <%= summary.presence || "Nothing here yet." %>
        <% end %>
      <% end %>
      <% tabs.tab(label: "Outline", id: "outline") do %>
        <div data-mcp-list="sections">
          <%= render FlatPack::List::Component.new(spacing: :dense) do %>
            <template data-mcp-list-item>
              <%= render FlatPack::List::Item.new do %>
                <span data-mcp-text="heading"></span>
              <% end %>
            </template>
          <% end %>
          <%= render FlatPack::EmptyState::Component.new(
            title: "Nothing here yet. Add a section to get going.",
            size: :sm,
            data: { mcp_list_empty: true }
          ) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
