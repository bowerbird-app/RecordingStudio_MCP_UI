<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.header do %>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Section notes",
      subtitle: "Open a block to read it.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>
  <% end %>
  <% card.body do %>
    <%= render FlatPack::Accordion::Component.new %>
  <% end %>
<% end %>
