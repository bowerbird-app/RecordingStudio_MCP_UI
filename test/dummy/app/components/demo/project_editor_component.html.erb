<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.header do %>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Edit project",
      subtitle: "Change the details, then save.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>
  <% end %>
  <% card.body do %>
    <div data-controller="mcp-editor" class="mcp-ui-form">
      <%= render FlatPack::TextInput::Component.new(
        name: "title",
        id: "project_title",
        label: "Title",
        value: data["title"],
        data: { mcp_field: true, flat_pack_validate: false }
      ) %>
      <%= render mcp_error("title") %>

      <%= render FlatPack::TextArea::Component.new(
        name: "description",
        id: "project_description",
        label: "Description",
        value: data["description"],
        rows: 4,
        autogrow: false,
        data: { mcp_field: true, flat_pack_validate: false }
      ) %>
      <%= render mcp_error("description") %>

      <%= render FlatPack::Select::Component.new(
        name: "status",
        id: "project_status",
        label: "Status",
        options: Project::STATUSES,
        value: data["status"],
        placeholder: nil,
        data: { mcp_field: true, flat_pack_validate: false }
      ) %>
      <%= render mcp_error("status") %>

      <input type="hidden" name="id" data-mcp-field value="<%= ERB::Util.html_escape(data["id"].to_s) %>">
      <input type="hidden" name="revision" data-mcp-field value="<%= ERB::Util.html_escape(data["revision"].to_s) %>">

      <div class="mcp-ui-actions">
        <%= render FlatPack::Button::Component.new(
          text: "Save",
          style: :primary,
          size: :md,
          type: "button",
          data: { mcp_save: "save" }
        ) %>
        <%= render FlatPack::Button::Component.new(
          text: "Cancel",
          style: :secondary,
          size: :md,
          type: "button",
          data: { mcp_reset: true }
        ) %>
      </div>
      <%= render mcp_status %>
    </div>
  <% end %>
<% end %>
