<div data-controller="mcp-editor" class="mcp-ui-form">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit project",
    subtitle: "Changes save through the registered projects.update action.",
    variant: :h3
  ) %>

  <div class="mcp-ui-field">
    <label for="project_title">Title</label>
    <input id="project_title" type="text" name="title" data-mcp-field value="<%= ERB::Util.html_escape(data['title'].to_s) %>">
    <p data-mcp-error="title" class="mcp-ui-error" hidden></p>
  </div>

  <div class="mcp-ui-field">
    <label for="project_description">Description</label>
    <textarea id="project_description" name="description" data-mcp-field rows="4"><%= ERB::Util.html_escape(data['description'].to_s) %></textarea>
    <p data-mcp-error="description" class="mcp-ui-error" hidden></p>
  </div>

  <%= render FlatPack::Select::Component.new(
    name: "status",
    id: "project_status",
    label: "Status",
    options: Project::STATUSES,
    value: data["status"],
    placeholder: nil,
    data: { mcp_field: true, flat_pack_validate: false }
  ) %>
  <p data-mcp-error="status" class="mcp-ui-error" hidden></p>

  <input type="hidden" name="id" data-mcp-field value="<%= ERB::Util.html_escape(data['id'].to_s) %>">
  <input type="hidden" name="revision" data-mcp-field value="<%= ERB::Util.html_escape(data['revision'].to_s) %>">

  <div class="mcp-ui-actions">
    <%= render FlatPack::Button::Component.new(
      text: "Save",
      style: :primary,
      size: :md,
      type: "button",
      data: { mcp_save: "save" }
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Cancel",
      style: :secondary,
      size: :md,
      type: "button",
      data: { mcp_reset: true }
    ) %>
  </div>
  <p data-mcp-status class="mcp-ui-status" hidden></p>
</div>
