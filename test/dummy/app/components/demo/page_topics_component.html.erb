<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.header do %>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Topics",
      subtitle: "The tags on this page.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>
  <% end %>
  <% card.body do %>
    <% if topics.any? %>
      <%= render FlatPack::ChipGroup::Component.new do %>
        <% topics.each_with_index do |topic, index| %>
          <%= render FlatPack::Chip::Component.new(
            text: topic,
            type: :button,
            selected: index.zero?,
            style: index.zero? ? :primary : :default,
            value: topic
          ) %>
        <% end %>
      <% end %>
    <% else %>
      <p>No topics yet.</p>
    <% end %>
  <% end %>
<% end %>
