<%= render FlatPack::Card::Component.new(shadow: :md) do |card| %>
  <% card.header do %>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Project preview",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>
  <% end %>
  <% card.body do %>
    <div class="mcp-ui-card">
      <h3 data-mcp-text="title"><%= ERB::Util.html_escape(title.to_s) %></h3>
      <p data-mcp-text="description"><%= ERB::Util.html_escape(description.to_s) %></p>
      <p data-mcp-text="status"><%= ERB::Util.html_escape(status.to_s) %></p>
    </div>
  <% end %>
  <% card.footer do %>
    <%= render FlatPack::Button::Component.new(
      text: "Open project",
      style: :secondary,
      size: :md,
      type: "button",
      data: { mcp_link_field: "url" }
    ) %>
  <% end %>
<% end %>
