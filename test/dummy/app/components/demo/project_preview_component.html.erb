<%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
  <% card.header do %>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Project preview",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>
  <% end %>
  <% card.body do %>
    <div class="mcp-ui-card">
      <%= render FlatPack::Content::Component.new(
        class: "font-semibold text-[var(--surface-content-color)]",
        data: { mcp_text: "title" }
      ) do %>
        <%= mcp_reading(title) %>
      <% end %>
      <%= render FlatPack::Content::Component.new(data: { mcp_text: "description" }) do %>
        <%= mcp_reading(description) %>
      <% end %>
      <%= render FlatPack::Badge::Component.new(
        text: mcp_reading(status),
        style: :info,
        data: { mcp_text: "status" }
      ) %>
    </div>
  <% end %>
<% end %>
