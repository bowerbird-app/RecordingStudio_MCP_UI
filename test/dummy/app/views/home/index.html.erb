<% dummy_page_nav(title: "MCP UI Demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "MCP UI Demo",
    subtitle: "A project card, an editor, and topic chips that fill in from the tool result.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Demo A — read-only card",
          subtitle: "Registration, lookup, rendering, and HTML packaging.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>
      <% card.body do %>
        <p class="text-sm leading-6">A Project preview widget showing title, description, and status.</p>
      <% end %>
      <% card.footer do %>
        <% if @project %>
          <%= link_to demo_path(@project), class: "inline-flex" do %>
            <%= render FlatPack::Button::Component.new(text: "Open preview", style: :primary, size: :md) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Demo B — project editor",
          subtitle: "Dirty state, validation, conflicts, and a real save.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>
      <% card.body do %>
        <p class="text-sm leading-6">Edits call the registered <code>projects.update</code> tool.</p>
      <% end %>
      <% card.footer do %>
        <% if @project %>
          <%= link_to edit_demo_path(@project), class: "inline-flex" do %>
            <%= render FlatPack::Button::Component.new(text: "Open editor", style: :secondary, size: :md) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Topics",
          subtitle: "Chips from a tool result, starting from an empty read.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>
      <% card.body do %>
        <p class="text-sm leading-6">Show topics fills three chips. Clear topics brings back the empty line.</p>
      <% end %>
      <% card.footer do %>
        <%= link_to topics_widget_path, class: "inline-flex" do %>
          <%= render FlatPack::Button::Component.new(text: "Open topics", style: :primary, size: :md) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
